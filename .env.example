# ═══════════════════════════════════════════════
# 金鹰数据中心 - 环境变量配置示例
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 排除）
# ═══════════════════════════════════════════════

# 后端认证：token 签名密钥（部署时务必改为随机长字符串）
AUTH_SECRET=please-change-this-to-a-random-long-string

# 后端认证：管理员初始默认密码（首次启动用，登录后请在系统内修改）
AUTH_DEFAULT_PASSWORD=admin123

# 金鹰安全系统爬虫登录账号
JINYING_USER=your-username
JINYING_PASSWORD=your-password
